<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>a29c84f3-dccf-4a45-b139-f8effd676cd0</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.11" />
		<!-- PostgreSQL provider (selectable at runtime via Database:Provider). -->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="Community.Microsoft.Extensions.Caching.PostgreSql" Version="6.0.2" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<!-- 10.2.3 raises the transitive Microsoft.OpenApi floor to 2.7.5, resolving CVE-2026-49451
		     (GHSA-v5pm-xwqc-g5wc, stack-overflow DoS via circular schema refs; 10.1.7 pinned 2.4.1). -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
		<!-- YandexMusic client (https://www.nuget.org/packages/YandexMusic). Source lives at
		     C:\Job\Projects\FrigaT\YandexMusic; improvements there ship as new package versions. -->
		<PackageReference Include="YandexMusic" Version="0.2.0" />
		<PackageReference Include="YandexMusic.DependencyInjection" Version="0.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PlaylistShare.Shared\PlaylistShare.Shared.csproj" />
		<!--
			Наборы миграций. Api их код не вызывает, но ссылки обязаны быть: MigrationsAssembly
			грузит сборку по имени через Assembly.Load, а тот ищет её в deps.json. Без
			ProjectReference сборки там не окажется и Database.Migrate() на старте упадёт с
			FileNotFoundException, даже если dll лежит рядом с Api.dll.
			PlaylistShare.Database подтягивается транзитивно через них.
		-->
		<ProjectReference Include="..\PlaylistShare.Database.SqlServer\PlaylistShare.Database.SqlServer.csproj" />
		<ProjectReference Include="..\PlaylistShare.Database.Postgres\PlaylistShare.Database.Postgres.csproj" />
	</ItemGroup>
</Project>
