@page "/connect-yandex"
@layout EmptyLayout
@attribute [Authorize]
@using System.Text.RegularExpressions
@using System.Threading
@using PlaylistShare.Shared.DTO
@using PlaylistShare.Shared.Yandex
@using PlaylistShare.Pwa.Components.Common
@implements IDisposable
@inject HttpClient Http
@inject ISnackbarService Snackbar
@inject NavigationManager Navigation

<PageTitle>Подключить Яндекс Музыку</PageTitle>

<div class="deka-auth">
    <div class="deka-auth-blob deka-auth-blob--tr"></div>

    <div class="deka-connect-box">
        @if (_hasReturnTo)
        {
            <FlareButton Class="deka-connect-back" OnClick="GoBack">
                <LeadingIcon><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></LeadingIcon>
                <ChildContent>Настройки</ChildContent>
            </FlareButton>
        }

        <div class="deka-connect-head">
            <div class="deka-connect-head-mark deka-gradient-mark"><DekaMark Size="26" /></div>
            <div>
                <h1>Подключить Яндекс Музыку</h1>
                <p>Чтобы получить ваши плейлисты</p>
            </div>
        </div>

        <div class="deka-seg">
            <FlareButton Class="@(_tabIndex == 0 ? "deka-seg-item deka-seg-item--active" : "deka-seg-item")" OnClick="() => _tabIndex = 0">QR-код</FlareButton>
            <FlareButton Class="@(_tabIndex == 1 ? "deka-seg-item deka-seg-item--active" : "deka-seg-item")" OnClick="() => _tabIndex = 1">Токен</FlareButton>
        </div>

        <div class="deka-connect-card">
            @if (_tabIndex == 0)
            {
                <div class="deka-connect-qr">
                    @if (_qrUrl != null)
                    {
                        <div class="deka-connect-qr-frame"><FlareQrCode Value="@_qrUrl" Size="176" ForeColor="#000000" BackColor="#ffffff" AriaLabel="QR-код для входа в Яндекс" /></div>
                        <p>Отсканируйте QR или откройте <a href="@_qrUrl" target="_blank" rel="noopener">@_qrUrl</a></p>
                        <p style="margin-top:-6px">и введите код: <b style="font-size:20px;letter-spacing:2px;color:var(--flare-color-primary)">@_userCode</b></p>
                        <div style="font-size:13px;color:var(--flare-color-on-surface-variant)">Статус: @_qrStatusText</div>
                        @if (_qrWaiting)
                        {
                            <div style="margin-top:14px"><FlareProgress Variant="ProgressVariant.Circular" Size="24" /></div>
                        }
                        @if (_qrError != null)
                        {
                            <div style="margin-top:14px;width:100%"><FlareAlert Severity="AlertSeverity.Error">@_qrError</FlareAlert></div>
                        }
                    }
                    else
                    {
                        <FlareProgress Variant="ProgressVariant.Circular" />
                    }
                </div>
            }
            else
            {
                <FlareButton Class="deka-btn-secondary" FullWidth="true"
                             Href="https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d"
                             Target="_blank" Rel="noopener">
                    <LeadingIcon><FlareIcon Icon="@PlaylistShare.Pwa.CustomIcons.Yandex" /></LeadingIcon>
                    <ChildContent>Войти в Яндекс</ChildContent>
                </FlareButton>
                <label class="deka-label">Access-токен</label>
                <FlareTextArea Rows="3" Placeholder="Вставьте ваш токен или ссылку" Style="margin-bottom:14px"
                               Class="deka-token-area" @bind-Value="_tokenInput" Immediate="true" />
                <div class="deka-connect-hintbox">
                    <div class="deka-connect-hintbox-title">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" /><path d="M12 11v5M12 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                        Где взять токен
                    </div>
                    <p>Ссылка вида https://music.yandex.ru/#access_token=ВАШ_ТОКЕН - вставьте её целиком.</p>
                </div>
                @if (_tokenError)
                {
                    <div style="color:var(--flare-color-error);font-size:13px;margin-bottom:12px">Токен не найден</div>
                }
                <FlareButton Class="deka-cta" OnClick="SubmitToken">Подключить по токену</FlareButton>
            }
        </div>

        <div class="deka-connect-note">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="10" rx="2.5" stroke="currentColor" stroke-width="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2" /></svg>
            Данные не покидают ваш аккаунт
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnTo { get; set; }

    private bool _hasReturnTo => !string.IsNullOrWhiteSpace(ReturnTo);
    private int _tabIndex;

    private string? _qrUrl;
    private string _userCode = "";
    private string? _qrSessionId;
    private string _qrStatusText = "Ожидание сканирования";
    private bool _qrWaiting = true;
    private string? _qrError;
    private CancellationTokenSource? _qrCts;

    private string _tokenInput = "";
    private bool _tokenError;

    protected override async Task OnInitializedAsync()
    {
        await StartQrFlow();
    }

    private void GoBack() => Navigation.NavigateTo(ReturnTo!);

    private async Task StartQrFlow()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<YandexAuthQr>>("/api/yandexaccount/qr");
            if (response is not { Success: true, Data: not null })
            {
                ShowQrError("Не удалось получить QR-код");
                return;
            }

            _qrUrl = response.Data.QrLink;
            _userCode = response.Data.UserCode;
            _qrSessionId = response.Data.SessionId;
            _qrCts = new CancellationTokenSource();
            _ = PollQrStatus(_qrCts.Token);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowQrError(ex.Message);
        }
    }

    private async Task PollQrStatus(CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(500, token);
                var statusResponse = await Http.GetFromJsonAsync<ApiResponse<YandexAuthQrCheck>>($"/api/yandexaccount/qr/{_qrSessionId}", token);
                if (statusResponse?.Data == null) continue;

                switch (statusResponse.Data.Status)
                {
                    case Shared.Enums.YandexAuthQrStatus.Pending:
                        _qrStatusText = "Ожидание подтверждения...";
                        break;
                    case Shared.Enums.YandexAuthQrStatus.Authorized:
                        _qrWaiting = false;
                        Snackbar.Show("Яндекс Музыка подключена", SnackbarSeverity.Success);
                        _qrCts?.Cancel();
                        OnConnected();
                        return;
                    case Shared.Enums.YandexAuthQrStatus.Expired:
                        _qrCts?.Cancel();
                        ShowQrError("Срок действия QR-кода истёк");
                        return;
                    case Shared.Enums.YandexAuthQrStatus.Error:
                        _qrCts?.Cancel();
                        ShowQrError("Ошибка авторизации");
                        return;
                }
                StateHasChanged();
            }
            catch (TaskCanceledException) { break; }
            catch (Exception ex)
            {
                ShowQrError(ex.Message);
                break;
            }
        }
    }

    private void ShowQrError(string message)
    {
        _qrError = message;
        _qrWaiting = false;
        StateHasChanged();
    }

    private async Task SubmitToken()
    {
        var token = ExtractToken(_tokenInput);
        if (string.IsNullOrWhiteSpace(token))
        {
            _tokenError = true;
            Snackbar.Show("Токен не найден", SnackbarSeverity.Error);
            return;
        }

        _tokenError = false;
        var response = await Http.PostAsJsonAsync("/api/yandexaccount/token", new SetYandexTokenRequest { Token = token });
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Show("Яндекс Музыка подключена", SnackbarSeverity.Success);
            OnConnected();
        }
        else
        {
            Snackbar.Show("Ошибка подключения. Повторите позже.", SnackbarSeverity.Error);
        }
    }

    private static string ExtractToken(string input) =>
        input.Contains("access_token=") ? Regex.Match(input, @"access_token=([^&]+)").Groups[1].Value : input.Trim();

    private void OnConnected() => Navigation.NavigateTo(_hasReturnTo ? ReturnTo! : "/my-playlists");

    public void Dispose()
    {
        _qrCts?.Cancel();
        _qrCts?.Dispose();
    }

    public class SetYandexTokenRequest { public string Token { get; set; } = ""; }
}
