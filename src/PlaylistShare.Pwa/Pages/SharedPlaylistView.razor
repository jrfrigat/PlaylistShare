@page "/shared/{token}"
<PageTitle>@_playlist?.Title - Playlist Share</PageTitle>

<HeadContent>
    <meta property="og:title" content="@(_playlist?.Title ?? "Поделиться плейлистом")" />
    <meta property="og:description" content="@($"Слушайте плейлист '{_playlist?.Title}' на Playlist Share")" />
    @if (!string.IsNullOrEmpty(_playlist?.CoverUrl))
    {
        <meta property="og:image" content="@_playlist.CoverUrl" />
    }
    <meta property="og:url" content="@Navigation.Uri" />
    <meta property="og:type" content="music.playlist" />
</HeadContent>

@using PlaylistShare.Pwa.Components.Common
@using PlaylistShare.Pwa.Components.SharedPlaylist
@using PlaylistShare.Pwa.Extensions
@using PlaylistShare.Shared.DTO
@using PlaylistShare.Shared.Enums
@using PlaylistShare.Pwa.Services
@using PlaylistShare.Shared.SharedPlaylist
@using PlaylistShare.Shared.Yandex
@inject HttpClient Http
@inject ISnackbarService Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject IAudioPlayerService AudioPlayerService
@inject IJSRuntime JS
@inject AppBarState AppBar
@implements IDisposable

<FlareContainer MaxWidth="ContainerMaxWidth.Full" Class="pb-2 px-0">
    @* На мобильном "назад" живёт в контекстном app bar (см. AppBar.Set ниже); в контенте кнопку
       показываем только на десктопе (>=960 = Below Md), где мобильного хедера нет. *@
    <FlareHidden Below="Breakpoint.Md">
        <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Secondary" OnClick="GoBack" Class="deka-back-btn">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowBack" /></LeadingIcon>
            <ChildContent>Назад</ChildContent>
        </FlareButton>
    </FlareHidden>

    @if (_loading)
    {
        <div class="deka-playlist-hero">
            <FlareSkeleton Width="224px" Height="224px" Variant="SkeletonVariant.Rect" Class="deka-playlist-cover" />
            <FlareStack Gap="FlareSpacing.Small" Class="flex-grow-1">
                <FlareSkeleton Width="200px" Height="32px" Variant="SkeletonVariant.Text" />
                <FlareSkeleton Width="140px" Height="18px" Variant="SkeletonVariant.Text" />
            </FlareStack>
        </div>
        <TrackItemSkeleton />
        <TrackItemSkeleton />
        <TrackItemSkeleton />
        <TrackItemSkeleton />
        <TrackItemSkeleton />
    }
    else
    {
        @* Действия лежат внутри hero: на десктопе grid ставит их в правую колонку под описанием,
           а на мобильном - отдельной строкой во всю ширину (там обложка ужимается и встаёт рядом
           с названием). Литеральный div (а не FlareStack) - чтобы scoped-CSS применялся. *@
        @* Кнопку "Слушать" убрали - треки запускаются кликом по строке. Остаются "Добавить"
           и группа icon-действий (поделиться / Яндекс / избранное / настройки). *@
            <section class="deka-playlist-hero">
                @* Обложка с neon glow по контуру *@
                <div class="deka-playlist-cover-wrap">
                    @if (!string.IsNullOrEmpty(_playlist?.CoverUrl))
                    {
                        <FlareImage Src="@_playlist.CoverUrl.FormatCoverUrl(344, 344)"
                                Height="224px" Width="224px"
                                    Class="deka-playlist-cover" />
                    }
                    else
                    {
                        <div class="deka-playlist-cover deka-playlist-cover--fallback deka-playlist-cover--lg">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.LibraryMusic" />
                        </div>
                    }
                </div>

                <div class="deka-playlist-info">
                    @* Badge: совместный плейлист *@
                    @if (_playlist?.AddPermission == EditPermission.Everyone
                         || _playlist?.AddPermission == EditPermission.AuthorizedOnly)
                    {
                        <span class="deka-playlist-badge">
                            <span class="deka-pill__dot deka-pill__dot--live"></span>
                            Совместный плейлист
                        </span>
                    }

                    @* Заголовок *@
                    <FlareText Element="h1"
                               Typo="TypographyScale.DisplayLarge"
                               Class="deka-playlist-title">
                        @_playlist?.Title
                    </FlareText>

                    @* Description — заглушка, будет из API *@
                    <p class="deka-playlist-description">
                        Собираем лучшие треки для тусовок и поездок с друзьями.
                        Добавляйте свои находки и формируйте общий вайб.
                    </p>

                    @* Stats: creator • N треков • длительность *@
                    <div class="deka-playlist-stats">
                        <div class="deka-playlist-stats__creator">
                            <FlareAvatar Size="AvatarSize.Xs" Text="@_playlist?.Creator?.UserName" />
                            <span>@_playlist?.Creator?.UserName</span>
                        </div>
                        <span class="deka-playlist-stats__sep">•</span>
                        <span class="deka-playlist-stats__num">@_playlistTrackCount треков</span>
                        <span class="deka-playlist-stats__sep">•</span>
                        <span class="deka-playlist-stats__num">
                            @_playlistDurationMs.FormatDuration(LongExtensions.FormatDurationType.hhmmss)
                        </span>
                    </div>

                    @* Collaborators — заглушка с avatar group *@
                    <div class="deka-playlist-collaborators">
                        <div class="deka-collab-avatars">
                            <div class="deka-collab-avatar"><FlareAvatar Size="AvatarSize.Sm" Text="A" /></div>
                            <div class="deka-collab-avatar"><FlareAvatar Size="AvatarSize.Sm" Text="M" /></div>
                            <div class="deka-collab-avatar"><FlareAvatar Size="AvatarSize.Sm" Text="N" /></div>
                            <div class="deka-collab-avatar"><FlareAvatar Size="AvatarSize.Sm" Text="V" /></div>
                            <div class="deka-collab-avatar deka-collab-avatar--more">+4</div>
                        </div>
                        <span class="deka-playlist-collaborators__label">8 участников курируют трек-лист</span>
                        <button class="deka-playlist-invite-btn" type="button">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" SizePx="14" />
                            <span>+ Пригласить друга</span>
                        </button>
                    </div>
                </div>
            </section>

            @* Action toolbar: большая кнопка Слушать + действия + sync pill *@
            <div class="deka-playlist-toolbar">
                <div class="deka-playlist-toolbar__actions">
                    <FlareButton Variant="ButtonVariant.Filled"
                                 Color="@FlareColor.Primary"
                                 Size="ButtonSize.Lg"
                                 OnClick="PlayAll"
                                 Class="deka-playlist-play-btn">
                        <LeadingIcon>
                            <FlareIconView Value="@MaterialDesign3Icons.Filled.PlayArrow" />
                        </LeadingIcon>
                        <ChildContent>Слушать</ChildContent>
                    </FlareButton>

                    @if (_canAdd)
                    {
                        <FlareButton Variant="ButtonVariant.Elevated" OnClick="GoToAddTracks">
                            <LeadingIcon>
                                <FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" />
                            </LeadingIcon>
                            <ChildContent>Добавить трек</ChildContent>
                        </FlareButton>
                    }

                <FlareButton Variant="ButtonVariant.Elevated" OnClick="SharePlaylist">
                        <LeadingIcon>
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.QrCode2" />
                        </LeadingIcon>
                        <ChildContent>Поделиться</ChildContent>
                    </FlareButton>

                    @if (_isCreator && _isAuthenticated)
                    {
                        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Tune"
                                     Variant="ButtonVariant.Elevated"
                                         OnClick="OpenPermissionsDialog"
                                         AriaLabel="Настройки доступа" />
                    }
                </div>

                <div class="deka-playlist-sync-pill">
                    <FlareIconView Value="@CustomIcons.YandexMusic" SizePx="14" />
                    <span>Синхронизация с Яндекс Музыкой</span>
                    <span class="deka-playlist-sync-pill__sep"></span>
                    <span class="deka-playlist-sync-pill__status">Активна</span>
                </div>
            </div>

        @if (_tracksLoading)
        {
            <TrackItemSkeleton />
            <TrackItemSkeleton />
            <TrackItemSkeleton />
            <TrackItemSkeleton />
            <TrackItemSkeleton />
        }
        else
        {
            @if (_tracks.Count > 8)
            {
                <FlareTextField TValue="string" @bind-Value="_trackFilter" @bind-Value:after="ApplyTrackFilter"
                            Variant="InputVariant.Outlined" Placeholder="Поиск трека..." Class="deka-search">
                    <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Color="FlareColor.Secondary" /></AdornmentStart>
                </FlareTextField>
            }
            @* Виртуализация списка: в DOM живут только видимые строки плюс буфер. Штатный Virtualize
               скроллится вместе со страницей - ему не нужен свой контейнер с фиксированной высотой,
               в отличие от FlareVirtualList/FlareList/FlareDataGrid, которые виртуализируют только
               внутри собственной прокрутки (у FlareDataGrid ещё и Virtual включается лишь когда у
               него есть Height, то есть при прокрутке страницей он не рециклит строки вовсе).
               ItemSize обязан совпадать с реальным шагом строки, иначе полоса прокрутки прыгает.
               Замерено в браузере: 73px = строка 69 + зазор 4. Строка выходит 69, а не 62, из-за
               обёртки обложки: .deka-track-cover - inline-block, и её блок-родитель добавляет снизу
               место под нижние выносные (50px обложки живут в 57px строки). Шаг одинаков для всех
               вариантов строки - и с чипом "кем добавлен", и с кнопкой удаления.
               Строку-обёртку рисуем литеральным div, а не FlareStack: scoped-CSS страницы вешает
               свой атрибут только на СВОЮ разметку, на корень дочернего компонента он не попадает,
               и правило для класса на FlareStack молча не применилось бы. *@
            <div class="deka-ptr-header">
                <span class="deka-ptr-header__num">#</span>
                <span class="deka-ptr-header__title">Трек и исполнитель</span>
                <span class="deka-ptr-header__album">Альбом</span>
                <span class="deka-ptr-header__contributor">Кто добавил</span>
                <span class="deka-ptr-header__like">Лайк</span>
                <span class="deka-ptr-header__duration">Время</span>
                <span></span>
            </div>
            <div class="deka-track-list">
                <Virtualize Items="@_filteredTracks" Context="track" ItemSize="73" OverscanCount="6">
                    <div class="deka-track-row-wrap">
                        <div class="deka-track-row-item">
                            <PlaylistTrackRow Index="@(_filteredTracks.IndexOf(track) + 1)" Track="@track" PlaylistShareToken="@Token" CanPlay="@_canPlay" CanRemove="@_removableTrackIds.Contains(track.TrackId)"
                                              IsCurrent="@(AudioPlayerService.CurrentTrackId == track.TrackId)"
                                              AddedByName="@(_trackAdditions.TryGetValue(track.TrackId, out var n) ? n : null)" />
                        </div>
                        @if (_removableTrackIds.Contains(track.TrackId))
                        {
                            <div class="deka-track-remove">
                                <FlareIconButton Icon="@MaterialDesign3Icons.Regular.MoreVert" Size="ButtonSize.Sm" OnClick="() => OnRemoveTrack(track)" AriaLabel="Удалить трек" />
                            </div>
                        }
                    </div>
                </Virtualize>
            </div>
            @if (!string.IsNullOrWhiteSpace(_trackFilter) && _filteredTracks.Count == 0)
            {
                <FlareText Typo="TypographyScale.BodyMedium" Color="FlareColor.Secondary" Class="pa-4 text-center">
                    В плейлисте нет треков по запросу "@_trackFilter"
                </FlareText>
            }
        }
    }

    <div class="deka-playlist-quick-add">
        <div class="deka-playlist-quick-add__icon">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.QueueMusic" SizePx="24" />
        </div>
        <div class="deka-playlist-quick-add__text">
            <FlareText Typo="TypographyScale.LabelMedium">Не нашли свой любимый трек?</FlareText>
            <FlareText Typo="TypographyScale.BodySmall" Color="@FlareColor.OnSurfaceVariant2">
                Вставьте ссылку из Яндекс Музыки, чтобы сразу добавить его в плейлист
            </FlareText>
        </div>
        <FlareButton Variant="ButtonVariant.Tonal"
                     Color="@FlareColor.Primary"
                     OnClick="OpenQuickAddDialog">
            Быстрая вставка ссылки
        </FlareButton>
    </div>
</FlareContainer>

@code {
    /// <summary>Токен расшаренного плейлиста</summary>
    [Parameter] public required string Token { get; set; }

    /// <summary>Свойства плейлиста.</summary>
    private SharedPlaylistDto? _playlist;
    /// <summary>Пользователь является создателем плейлиста.</summary>
    private bool _isCreator;
    /// <summary>Пользователь имеет право воспроизведения треков.</summary>
    private bool _canPlay;
    /// <summary>Пользователь имеет право добавления треков в плейлист.</summary>
    private bool _canAdd;
    /// <summary>
    /// Id треков, которые пользователю разрешено удалить. Приходит готовым с сервера вместе с
    /// треками: право на удаление зависит от того, кто добавил трек (RemovePermission.AddedByUserOnly),
    /// и на клиенте не вычисляется.
    /// </summary>
    private HashSet<string> _removableTrackIds = new();
    /// <summary>Пользователь авторизован из под учетной записи.</summary>
    private bool _isAuthenticated;
    /// <summary>Текущий ID пользователя, если авторизован.</summary>
    private string? _currentUserId;

    /// <summary>Состояние: Происходит загрузка плейлиста.</summary>
    private bool _loading = true;
    /// <summary>Состояние: Происходит загрузка треков плейлиста.</summary>
    private bool _tracksLoading = true;

    /// <summary>
    /// Список ID треков, уже добавленных в плейлист.
    /// </summary>
    private HashSet<string> _existingTrackIds = new();
    /// <summary>
    /// Список добавленных в плейлист треков.
    /// </summary>
    private List<YandexTrack> _tracks = new();
    /// <summary>Текст фильтра по трекам плейлиста (клиентский поиск по названию/исполнителю).</summary>
    private string _trackFilter = "";
    /// <summary>
    /// Треки плейлиста с учётом фильтра - готовый список, а не ленивый запрос. Virtualize берёт
    /// источник по индексу и спрашивает его Count на каждую прокрутку: ленивый Where пересчитывал бы
    /// весь фильтр на каждом кадре. Пересоздаём его (ApplyTrackFilter) при смене фильтра и при любом
    /// изменении _tracks, а не мутируем на месте - иначе Virtualize не заметит смены источника.
    /// </summary>
    private List<YandexTrack> _filteredTracks = new();

    /// <summary>Пересобирает <see cref="_filteredTracks"/> под текущий текст фильтра.</summary>
    private void ApplyTrackFilter() =>
        _filteredTracks = string.IsNullOrWhiteSpace(_trackFilter)
            ? new List<YandexTrack>(_tracks)
            : _tracks.Where(t =>
                t.Title.Contains(_trackFilter, StringComparison.InvariantCultureIgnoreCase) ||
                t.Artists.Any(a => a.Name.Contains(_trackFilter, StringComparison.InvariantCultureIgnoreCase)))
                .ToList();
    /// <summary>
    /// Словарь trackId -> имя пользователя, добавившего трек.
    /// </summary>
    private Dictionary<string, string?> _trackAdditions = new();
    /// <summary>
    /// Продолжительность плейлиста.
    /// </summary>
    long _playlistDurationMs;
    /// <summary>
    /// Кол-во треков в ПЛ.
    /// </summary>
    int _playlistTrackCount;

    /********************************
     * Контекстные кнопки
    *********************************/
    /// <summary>Признак, что альбом в фаворитах.</summary>
    private bool _isFavorite;
    /// <summary>Загрузка признака "фаворит".</summary>
    private bool _favoriteLoading;

    /********************************
     * Поделиться ссылкой
    *********************************/
    private IJSObjectReference? _shareModule;
    private bool _isWebShareSupported = false;

    /// <summary>Задать мобильный app bar: "назад" + заголовок (название плейлиста после загрузки).</summary>
    private void ApplyAppBar() =>
        AppBar.Set(_playlist?.Title ?? "Плейлист", showBack: true,
            back: () => { GoBack(); return Task.CompletedTask; });

    protected override async Task OnInitializedAsync()
    {
        ApplyAppBar();
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadPlaylist();
        await LoadTracks();
        AudioPlayerService.OnStartedTrack += OnPlayerStateChanged;
        AudioPlayerService.OnEndedTrack += OnPlayerStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Загружаем JS-модуль
            _shareModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/shareUtils.js");
            // Проверяем поддержку Web Share API
            _isWebShareSupported = await _shareModule.InvokeAsync<bool>("isSupported");
            StateHasChanged();
        }
    }

    private void OnPlayerStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Кнопка "Добавить" в шапке плейлиста - переходит на страницу поиска для добавления треков в этот плейлист.</summary>
    private void GoToAddTracks() => Navigation.NavigateTo($"/search?AddTo={Token}");

    /// <summary>Кнопка "Назад".</summary>
    private void GoBack() => Navigation.NavigateTo("/my-playlists");

    /// <summary>Установка разрешений.</summary>
    private async Task ConfigurePermissions()
    {
        if (_playlist is null)
        {
            _isCreator = false;
            _canAdd = false;
            _canPlay = false;
        }
        else
        {
            _isCreator = _playlist.CreatorUserId.ToString() == _currentUserId;

            _canAdd = _isCreator
            || _playlist.AddPermission == EditPermission.Everyone
            || (_playlist.AddPermission == EditPermission.AuthorizedOnly && _isAuthenticated);

            // Право на удаление тут не считаем: его на каждый трек отдаёт сервер в
            // YandexPlaylistData.RemovableTrackIds (см. _removableTrackIds).

            _canPlay = _isCreator
            || _playlist.PlayPermission == ViewPermission.Everyone
            || (_playlist.PlayPermission == ViewPermission.AuthorizedOnly && _isAuthenticated);

        }
    }

    /// <summary>Загрузка плейлиста.</summary>
    private async Task LoadPlaylist()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<SharedPlaylistDto>>($"/api/sharedplaylist/{Token}");
            if (response?.Success == true)
            {
                _playlist = response.Data;
                ApplyAppBar();

                await ConfigurePermissions();
                await CheckFavoriteStatus();
            }
            else
            {
                Snackbar.Show(response?.Error?.Message ?? "Не удалось загрузить плейлист", SnackbarSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Show($"Ошибка: {ex.Message}", SnackbarSeverity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Загрузка треков.</summary>
    private async Task LoadTracks()
    {
        if (_playlist == null) return;

        _tracksLoading = true;

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<YandexPlaylistData>>($"/api/sharedplaylist/{Token}/tracks");
            if (response?.Success == true && response.Data != null)
            {
                _tracks = response.Data.Tracks;
                ApplyTrackFilter();
                _removableTrackIds = response.Data.RemovableTrackIds;
                _existingTrackIds = _tracks.Select(t => t.TrackId).ToHashSet();
                _playlistDurationMs = _tracks.Sum(t => t.DurationMs);
                _playlistTrackCount = _tracks.Count();
                AudioPlayerService.SetQueue(_tracks, shareToken: Token);

                try
                {
                    var additionsResp = await Http.GetFromJsonAsync<ApiResponse<Dictionary<string, string?>>>($"/api/sharedplaylist/{Token}/additions");
                    if (additionsResp?.Success == true && additionsResp.Data != null)
                        _trackAdditions = additionsResp.Data;
                }
                catch (Exception ex)
                {
                    // не критично - имена добавивших треки просто не отобразятся
                    Console.WriteLine($"Не удалось загрузить информацию о добавлениях: {ex.Message}");
                }
            }
            else
            {
                Snackbar.Show(response?.Error?.Message ?? "Не удалось загрузить треки", SnackbarSeverity.Error);
            }

        }
        catch (Exception ex)
        {
            Snackbar.Show($"Ошибка загрузки треков: {ex.Message}", SnackbarSeverity.Error);
        }
        finally
        {
            _tracksLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>Удаление трека из списка плейлиста</summary>
    private async Task OnRemoveTrack(YandexTrack track)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Подтверждение удаления",
            $"Вы уверены, что хотите удалить трек \"{track.Title}\"?",
            "Удалить", "Отмена");

        if (confirmed != true) return;

        await RemoveTrack(track);
    }

    /// <summary>Удаление трека.</summary>
    private async Task RemoveTrack(YandexTrack track)
    {
        if (!_existingTrackIds.Contains(track.TrackId)) return;

        try
        {
            var request = new UpdateTrackListRequest { TrackIds = new List<string> { track.TrackId } };
            var response = await Http.PostAsJsonAsync($"/api/sharedplaylist/{Token}/remove-tracks", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Show("Трек удалён", SnackbarSeverity.Success);
                _tracks.Remove(track);
                ApplyTrackFilter(); // источник для Virtualize пересоздаём, а не правим на месте
                _existingTrackIds.Remove(track.TrackId);
                _playlistDurationMs -= track.DurationMs;
                _playlistTrackCount -= 1;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
                Snackbar.Show(error?.Error?.Message ?? "Ошибка удаления", SnackbarSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Show($"Ошибка: {ex.Message}", SnackbarSeverity.Error);
        }
        StateHasChanged();
    }

    #region Избранное / Фаворит
    /// <summary>Установка галочки "избранное"</summary>
    private async Task CheckFavoriteStatus()
    {
        if (string.IsNullOrWhiteSpace(Token)) return;
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<bool>>($"/api/favorites/{Token}/check");
            if (response?.Success == true)
                _isFavorite = response.Data;
        }
        catch (Exception ex)
        {
            // Не критично: не удалось - кнопка "избранное" останется в дефолтном состоянии. У анонима
            // это штатный 401.
            // Пишем в stdout, а НЕ в Console.Error: в Blazor WebAssembly запись в stderr хост
            // трактует как признак краха и показывает баннер #blazor-error-ui ("Произошла
            // необработанная ошибка"). Здесь ничего не падает, а баннер вставал поверх плеера с
            // z-index 2000 и перехватывал клики по всей странице.
            Console.WriteLine($"Не удалось проверить статус избранного: {ex.Message}");
        }
    }

    private async Task ToggleFavorite()
    {
        if (string.IsNullOrWhiteSpace(Token)) return;

        if (!_isAuthenticated)
        {
            Snackbar.Show("Добавление в избранное только авторизованным пользователям", SnackbarSeverity.Warning);
            return;
        }

        _favoriteLoading = true;
        try
        {
            if (_isFavorite)
            {
                var response = await Http.DeleteAsync($"/api/favorites/{Token}");
                if (response.IsSuccessStatusCode)
                {
                    _isFavorite = false;
                    Snackbar.Show("Плейлист удалён из избранного", SnackbarSeverity.Success);
                }
                else
                {
                    Snackbar.Show("Ошибка удаления из избранного", SnackbarSeverity.Error);
                }
            }
            else
            {
                var response = await Http.PostAsync($"/api/favorites/{Token}", null);
                if (response.IsSuccessStatusCode)
                {
                    _isFavorite = true;
                    Snackbar.Show("Плейлист добавлен в избранное", SnackbarSeverity.Success);
                }
                else
                {
                    Snackbar.Show("Ошибка добавления в избранное", SnackbarSeverity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Show($"Ошибка: {ex.Message}", SnackbarSeverity.Error);
        }
        finally
        {
            _favoriteLoading = false;
            StateHasChanged();
        }
    }
    #endregion

    #region Настройка доступов к плейлисту
    private async Task OpenPermissionsDialog()
    {
        if (_playlist == null) return;
        var playlist = _playlist; // локальная копия - гарантированно не null для инициализатора ниже

        var initial = new UpdatePermissionsDto
        {
            ViewPermission = playlist.ViewPermission,
            PlayPermission = playlist.PlayPermission,
            AddPermission = playlist.AddPermission,
            RemovePermission = playlist.RemovePermission
        };

        var parameters = new DialogParameters()
            .Add(nameof(PermissionsDialog.ShareToken), Token)
            .Add(nameof(PermissionsDialog.InitialPermissions), initial);

        var result = await DialogService.ShowAsync<PermissionsDialog>(
            "Настройки доступа",
            parameters,
            new DialogOptions { Size = DialogSize.Md });

        if (result.Cancelled || _playlist == null) return;

        if (result.GetData<UpdatePermissionsDto>() is { } dto)
        {
            _playlist.ViewPermission = dto.ViewPermission;
            _playlist.PlayPermission = dto.PlayPermission;
            _playlist.AddPermission = dto.AddPermission;
            _playlist.RemovePermission = dto.RemovePermission;
            await ConfigurePermissions();
            StateHasChanged();
        }
    }
    #endregion

    #region Поделиться ссылкой
    /// <summary> Поделиться ссылкой </summary>
    private async Task SharePlaylist()
    {
        if (_shareModule == null) return;

        var shareUrl = Navigation.Uri;
        var shareTitle = "Поделиться плейлистом";
        var shareText = _playlist?.Title != null
            ? $"Послушайте плейлист '{_playlist.Title}'!"
            : "Послушайте этот плейлист!";

        if (_isWebShareSupported)
        {
            var result = await _shareModule.InvokeAsync<ShareResult>("shareLink", shareTitle, shareText, shareUrl);
            if (result?.Success == false && !string.IsNullOrEmpty(result.Error) && !result.Cancelled)
            {
                Snackbar.Show($"Не удалось поделиться: {result.Error}", SnackbarSeverity.Warning);
                await ShowShareDialog(shareUrl);
            }
        }
        else
        {
            await ShowShareDialog(shareUrl);
        }
    }

    /// <summary> Модальное окно, чтобы поделиться ссылкой </summary>
    private async Task ShowShareDialog(string url)
    {
        var parameters = new DialogParameters()
            .Add(nameof(ShareDialog.ShareUrl), url)
            .Add(nameof(ShareDialog.ShareToken), _playlist?.ShareToken)
            .Add(nameof(ShareDialog.InitialPermissions), _playlist == null ? null : new UpdatePermissionsDto
            {
                ViewPermission = _playlist.ViewPermission,
                PlayPermission = _playlist.PlayPermission,
                AddPermission = _playlist.AddPermission,
                RemovePermission = _playlist.RemovePermission
            });

        await DialogService.ShowSheetAsync<ShareDialog>(
            "Поделиться плейлистом",
            parameters,
            new DialogOptions { Size = DialogSize.Sm });
    }

    // Вспомогательный класс для результата
    private class ShareResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public bool Cancelled { get; set; }
    }
    #endregion

    public void Dispose()
    {
        AudioPlayerService.OnStartedTrack -= OnPlayerStateChanged;
        AudioPlayerService.OnEndedTrack -= OnPlayerStateChanged;
        AppBar.Reset();

        _shareModule?.DisposeAsync();
    }

    /// <summary>Запустить воспроизведение плейлиста с первого трека.</summary>
    private async Task PlayAll()
    {
        var first = _tracks.FirstOrDefault();
        if (first is null) return;
        await AudioPlayerService.LoadAndPlayAsync(
            trackId: first.TrackId,
            playlistShareToken: Token,
            track: first);
    }

