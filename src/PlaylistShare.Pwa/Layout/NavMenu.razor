<FlareNavMenu AriaLabel="Основная навигация">

    <HeaderContent>
        <FlareStack Row Gap="FlareSpacing.XSmall" Align="FlareAlignItems.Center">
            <FlareIconView Size="2rem"
                           Color="@FlareColor.Primary"
                           Value="PlaylistShare.Pwa.CustomIcons.PlaylistShare" />
            <FlareText Typo="TypographyScale.HeadlineSmall"
                       Color="@FlareColor.Primary">
                PlaylistShare
            </FlareText>
        </FlareStack>
    </HeaderContent>

    <ChildContent>
        <FlareStack Gap="FlareSpacing.Medium">

            @* ── Основные разделы ───────────────────────────────────────── *@
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareNavLink Href="/search">
                    <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" /></IconContent>
                    <ChildContent>Поиск</ChildContent>
                </FlareNavLink>

                <FlareNavLink Href="/my-playlists">
                    <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.LibraryMusic" /></IconContent>
                    <ChildContent>Моя фонотека</ChildContent>
                </FlareNavLink>
            </FlareStack>

            @* ── Плейлисты друзей ───────────────────────────────────────── *@
            <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Typo="TypographyScale.LabelSmall"
                               Color="@FlareColor.OnSurfaceVariant2">
                        ПЛЕЙЛИСТЫ ДРУЗЕЙ
                    </FlareText>
            </FlareStack>

            @* ── Кнопки действий ────────────────────────────────────────── *@
            <FlareStack Gap="FlareSpacing.XXSmall">
                <FlareButton Variant="ButtonVariant.Filled"
                             Size="ButtonSize.Sm"
                             Typo="TypographyScale.LabelMedium"
                             FullWidth>
                    <LeadingIcon>
                        <FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" />
                    </LeadingIcon>
                    <ChildContent>
                        Создать плейлист
                    </ChildContent>
                </FlareButton>

                <FlareButton Variant="ButtonVariant.Text"
                             Size="ButtonSize.Sm"
                             Typo="TypographyScale.LabelSmall"
                             FullWidth
                             Color="@FlareColor.OnSurfaceVariant">
                    <LeadingIcon>
                        <FlareIconView Value="@MaterialDesign3Icons.Regular.Link" />
                    </LeadingIcon>
                    <ChildContent>
                        Присоединиться по ссылке
                    </ChildContent>
                </FlareButton>
            </FlareStack>
        </FlareStack>
    </ChildContent>

    <FooterContent>
        <AuthorizeView>
            <Authorized>
                <FlareCard Variant="CardVariant.Filled">
                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">

                        <FlareAvatar Text="@InitialOf(context.User.Identity?.Name)"
                                        Size="AvatarSize.Sm"
                                        Shape="AvatarShape.Rounded" />

                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Typo="TypographyScale.LabelMedium"
                                       Color="@FlareColor.OnSurface">
                                @(context.User.Identity?.Name ?? "Профиль")
                            </FlareText>
                            <FlareText Typo="TypographyScale.LabelSmall"
                                       Color="@FlareColor.Secondary">
                                В сети
                            </FlareText>
                        </FlareStack>

                        <FlareSpacer />

                        <FlareIconButton Icon="FlareIcons.Settings"
                                         Href="/profile"
                                         Size="ButtonSize.Sm"
                                         Color="@FlareColor.OnSurfaceVariant"
                                         AriaLabel="Настройки профиля" />
                    </FlareStack>
                </FlareCard>
            </Authorized>

            <NotAuthorized>
                <FlareNavLink Href="/login">
                    <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Login" /></IconContent>
                    <ChildContent>Вход</ChildContent>
                </FlareNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </FooterContent>

</FlareNavMenu>

@code {
    private static string InitialOf(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
}