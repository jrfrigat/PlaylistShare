@* Аудио-прогресс на FlareSlider. Буфер (загруженная часть) рисуется зоной от начала дорожки до
   загруженной точки, под активным заполнением - раньше это был кастомный бар, т.к. у FlareSlider не
   было вторичной дорожки. Позиция обновляется на лету через одностороннее Value.
   FlareZone (Flare 0.3.0) заменил FlareSliderZone: тот остался лишь тонким наследником с
   предупреждением об устаревании. *@
<FlareSlider Value="@Value" Min="@Min" Max="@Max" Step="@Step"
             Color="@Color" Size="@Size" MouseWheel="true" ShowValue="false"
             AriaLabel="Позиция воспроизведения" ValueChanged="ValueChanged">
    <Zones>
        @if (Buffer && BufferValue > Min)
        {
            <FlareZone Start="@Min" End="@BufferValue" Color="FlareColor.OnSurfaceVariant" />
        }
    </Zones>
</FlareSlider>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public double BufferValue { get; set; }
    [Parameter] public bool Buffer { get; set; } = true;
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public FlareColor Color { get; set; } = FlareColor.Primary;
    [Parameter] public TrackSize Size { get; set; } = TrackSize.Xs;
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
}
