@using Microsoft.JSInterop
@inject IAudioPlayerService AudioPlayerService
@inject IJSRuntime JS
@inject TokenStorage TokenStorage
@inject PlayerStorage PlayerStorage
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbarService Snackbar
@inject HttpClient Http
@implements IDisposable
@implements IAsyncDisposable

<div class="deka-player-bar player-enter">
    @* ── Левая зона: обложка + трек + лайк ─────────────────────────── *@
    <div class="deka-player-left">
        <div class="deka-player-cover" @onclick="Expand" role="button" tabindex="0" title="Открыть плеер">
            @if (!string.IsNullOrEmpty(AudioPlayerService.CurrentTrack?.CoverUri))
            {
                <FlareImage Src="@AudioPlayerService.CurrentTrack.CoverUri.FormatCoverUrl(92, 92)"
                            Height="100%" Width="100%" />
            }
        </div>

        @if (AudioPlayerService.CurrentTrack != null)
        {
            <div class="deka-player-meta" @onclick="Expand" role="button" tabindex="0" title="Открыть плеер">
                <span class="deka-player-title">@AudioPlayerService.CurrentTrack.Title</span>
                <span class="deka-player-artist">
                    @string.Join(", ", AudioPlayerService.CurrentTrack.Artists.Select(a => a.Name))
                </span>
            </div>
            <div class="deka-player-like" @onclick="Swallow" @onclick:stopPropagation="true">
                <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Favorite"
                                 Variant="ButtonVariant.Text"
                                 Color="FlareColor.Default"
                                 Size="ButtonSize.Sm"
                                 AriaLabel="В избранное"
                                 OnClick="Noop" />
            </div>
        }
        else
        {
            <span class="deka-player-placeholder">Ничего не играет</span>
        }
    </div>

    @* ── Центральная зона: транспорт + прогресс ────────────────────── *@
    <div class="deka-player-center">
        <div class="deka-player-transport" @onclick="Swallow" @onclick:stopPropagation="true">
            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Shuffle"
                             Variant="ButtonVariant.Text"
                             Color="FlareColor.Default"
                             Size="ButtonSize.Xs"
                             AriaLabel="Перемешать"
                             OnClick="Noop" />

            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.SkipPrevious"
                             Variant="ButtonVariant.Text"
                             Color="FlareColor.Default"
                             Size="ButtonSize.Xs"
                             Disabled="@(!AudioPlayerService.HasPrevious)"
                             AriaLabel="Предыдущий"
                             OnClick="() => AudioPlayerService.PlayPreviousAsync()" />

            <FlareIconButton Icon="@(AudioPlayerService.IsPlaying ? MaterialDesign3Icons.Filled.Pause : MaterialDesign3Icons.Filled.PlayArrow)"
                             Variant="ButtonVariant.Filled"
                             Color="FlareColor.Primary"
                             Shape="ButtonShape.Circular"
                             Size="ButtonSize.Sm"
                             Class="deka-play-toggle deka-play-toggle--filled"
                             AriaLabel="@(AudioPlayerService.IsPlaying ? "Пауза" : "Играть")"
                             OnClick="OnPlayClick" />

            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.SkipNext"
                             Variant="ButtonVariant.Text"
                             Color="FlareColor.Default"
                             Size="ButtonSize.Xs"
                             Disabled="@(!AudioPlayerService.HasNext)"
                             AriaLabel="Следующий"
                             OnClick="() => AudioPlayerService.PlayNextAsync()" />

            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Repeat"
                             Variant="ButtonVariant.Text"
                             Color="FlareColor.Default"
                             Size="ButtonSize.Xs"
                             AriaLabel="Повтор"
                             OnClick="Noop" />
        </div>

        @if (AudioPlayerService.CurrentTrack != null)
        {
            <div class="deka-player-progress-row" @onclick="Swallow" @onclick:stopPropagation="true">
                <span class="deka-player-time">@AudioPlayerService.CurrentTimeString</span>
                <div class="deka-player-progress-bar">
                    <TrackProgress Value="@AudioPlayerService.CurrentTime"
                                   Min="0" Max="@AudioPlayerService.TotalTime"
                                   BufferValue="@_bufferSecond"
                                   Color="FlareColor.Primary"
                                   Step="0.1"
                                   Buffer
                                   ValueChanged="SeekTo" />
                </div>
                <span class="deka-player-time">@AudioPlayerService.TotalTimeString</span>
            </div>
        }
    </div>

    @* ── Правая зона: иконки + sync pill + громкость ───────────────── *@
    <div class="deka-player-right">
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Lyrics"
                         Variant="ButtonVariant.Text"
                         Color="FlareColor.Default"
                         Size="ButtonSize.Sm"
                         AriaLabel="Текст песни"
                         OnClick="Noop" />

        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.QueueMusic"
                         Variant="ButtonVariant.Text"
                         Color="FlareColor.Default"
                         Size="ButtonSize.Sm"
                         AriaLabel="Очередь"
                         OnClick="Noop" />

        <div class="deka-player-sync-pill" title="Синхронизировано">
            <span class="deka-player-sync-dot"></span>
            <span>Синхронизировано</span>
        </div>

        <div class="deka-player-volume-inline"
             @onwheel="OnVolumeHandleWheel"
             @onclick="Swallow" @onclick:stopPropagation="true">
            <FlareIconButton Icon="@(AudioPlayerService.CurrentVolume == 0 ? MaterialDesign3Icons.Regular.VolumeOff : MaterialDesign3Icons.Regular.VolumeUp)"
                             Variant="ButtonVariant.Text"
                             Color="FlareColor.Default"
                             Size="ButtonSize.Sm"
                             AriaLabel="Громкость"
                             OnClick="ToggleMute" />
            <div class="deka-player-volume-slider">
                <FlareSlider Value="AudioPlayerService.CurrentVolume"
                             ValueChanged="ChangeVolume"
                             Min="0" Max="100" Step="1"
                             Color="FlareColor.Secondary"
                             Size="TrackSize.Xs"
                             ShowValue="false"
                             
                             AriaLabel="Громкость" />
            </div>
        </div>
    </div>

    @* Невидимая поверхность перемотки: клик по пустому фону бара открывает полный плеер,
       а не перемотку (в отличие от прошлого варианта). Перемотка теперь только по слайдеру. *@
</div>

<audio id="@_audioId" style="display: none;"></audio>

@code {
    /// <summary>Raised when the user taps the track title/artist area, requesting the full-screen player.</summary>
    [Parameter] public EventCallback OnExpandRequested { get; set; }

    private const double _volumeDefault = 50;

    /// <summary>Прогресс воспроизведения в процентах (0-100) для фоновой заливки плеера.</summary>
    private double ProgressPercent =>
        AudioPlayerService.TotalTime > 0
            ? Math.Clamp(AudioPlayerService.CurrentTime / AudioPlayerService.TotalTime * 100, 0, 100)
            : 0;

    // Генерируем уникальный ID для аудиоэлемента, чтобы избежать конфликтов при множественных экземплярах
    private string _audioId = $"audio_{Guid.NewGuid():N}";
    private IJSObjectReference? _audioModule;
    private IJSObjectReference? _audioElement;

    // Громкость: наведением заведует FlarePopover (Trigger=Hover), но состояние панели - наше.
    private bool _volumeIsOpen;
    private double _volumeBeforeMute;
    private double _bufferSecond;


    protected override async Task OnInitializedAsync()
    {
        AudioPlayerService.OnLoadAndPlayRequested += OnServiceLoadAndPlay;
        AudioPlayerService.OnPlayRequested += OnServicePlay;
        AudioPlayerService.OnPauseRequested += OnServicePause;
        AudioPlayerService.OnSeekRequested += OnServiceSeek;
        AudioPlayerService.OnVolumeChangeRequested += OnServiceVolumeChange;
        AudioPlayerService.OnStateChanged += OnServiceStateChanged;
    }

    protected override void OnParametersSet()
    {
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnsureAudioModuleAsync();
        }
    }

    private async Task EnsureAudioModuleAsync()
    {
        if (_audioModule == null)
            _audioModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/AudioPlayer.js");
        if (_audioElement == null)
        {
            _audioElement = await _audioModule.InvokeAsync<IJSObjectReference>("init", _audioId, DotNetObjectReference.Create(this));
            // Сохранённую громкость сервис поднимает из хранилища ещё до того, как появится <audio>,
            // поэтому применяем её здесь: иначе элемент стартует на 100%, а слайдер показывает
            // сохранённое значение - и первое же касание громкости даёт скачок звука.
            await _audioElement.InvokeVoidAsync("setVolume", AudioPlayerService.CurrentVolume / 100);
        }
    }

    #region Обработка JS
    [JSInvokable]
    public async Task OnAudioEnded()
    {
        AudioPlayerService.NotifyTrackEnded();
    }

    [JSInvokable]
    public async Task OnTimeUpdate(double currentTime, double duration)
    {
        if (!double.IsNaN(duration) && !double.IsNaN(currentTime) && duration > 0)
        {
            AudioPlayerService.UpdateProgress(currentTime, duration);
        }
    }

    [JSInvokable]
    public async Task OnDownloadProgress(double second)
    {
        _bufferSecond = second;
    }

    [JSInvokable]
    public async Task OnKeyboardTogglePlay()
    {
        if (AudioPlayerService.IsPlaying)
            await AudioPlayerService.PauseAsync();
        else
            await AudioPlayerService.PlayAsync();
    }

    [JSInvokable]
    public async Task OnKeyboardSeek(double delta)
    {
        var newTime = Math.Max(0, AudioPlayerService.CurrentTime + delta);
        await AudioPlayerService.SeekToAsync(newTime);
    }

    [JSInvokable]
    public async Task OnKeyboardVolumeChange(double delta)
    {
        var newVol = Math.Clamp(AudioPlayerService.CurrentVolume + delta, 0, 100);
        await AudioPlayerService.SetVolumeAsync(newVol);
    }
    #endregion

    #region Обработка сервиса
    private async Task OnServiceLoadAndPlay(string trackId, string? playToken, string? sharedPlaylistId)
    {
        if (string.IsNullOrWhiteSpace(playToken) && string.IsNullOrWhiteSpace(sharedPlaylistId))
        {
            Snackbar.Show("Токен авторизации не найден. Пожалуйста, войдите заново.", SnackbarSeverity.Error);
            return;
        }

        var streamUrl = new Uri(Http.BaseAddress!, $"/api/audio/track/{trackId}").ToString();
        await EnsureAudioModuleAsync();
        await _audioElement!.InvokeVoidAsync("loadAndPlay", streamUrl, playToken, sharedPlaylistId);
    }

    private async Task OnServicePlay()
    {
        if (_audioElement == null) return;
        await _audioElement.InvokeVoidAsync("play");
    }

    private async Task OnServicePause()
    {
        if (_audioElement == null) return;
        await _audioElement.InvokeVoidAsync("pause");
    }

    private async Task OnServiceSeek(double time)
    {
        if (_audioElement == null) return;
        try
        {
            await _audioElement.InvokeVoidAsync("setCurrentTime", time);
        }
        catch (Exception ex)
        {
            // Только тип исключения: Console в WASM видна пользователю, текст может утечь.
            Console.WriteLine($"Seek error: {ex.GetType().Name}");
        }
    }

    private async Task OnServiceVolumeChange(double volume)
    {
        if (_audioElement == null) return;

        try
        {
            await _audioElement.InvokeVoidAsync("setVolume", volume / 100);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Только тип исключения: Console в WASM видна пользователю, текст может утечь.
            Console.WriteLine($"Volume change error: {ex.GetType().Name}");
        }
    }

    private void OnServiceStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }
    #endregion

    private async Task<bool> CheckAuthAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated == true)
        {
            Snackbar.Show("Воспроизведение доступно только авторизованным пользователям", SnackbarSeverity.Warning);
            return false;
        }
        return true;
    }

    private async Task OnVolumeHandleWheel(WheelEventArgs e)
    {
        // Изменяем громкость на 5 единиц за один тик колесика
        double step = 5;
        double newVolume = e.DeltaY < 0
            ? Math.Min(AudioPlayerService.CurrentVolume + step, 100)
            : Math.Max(AudioPlayerService.CurrentVolume - step, 0);

        await ChangeVolume(newVolume);
    }

    private async Task SeekTo(double value)
    {
        await AudioPlayerService.SeekToAsync(value);
    }

    /// <summary>Перемотка кликом/протяжкой по фону бара (ПК). Значение приходит строкой от range.</summary>
    private async Task OnSeekSurfaceInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                            System.Globalization.CultureInfo.InvariantCulture, out var value))
            await AudioPlayerService.SeekToAsync(value);
    }

    private async Task ChangeVolume(double value)
    {
        await AudioPlayerService.SetVolumeAsync(value);
    }

    private async Task ToggleMute()
    {
        if (AudioPlayerService.CurrentVolume > 0)
        {
            _volumeBeforeMute = AudioPlayerService.CurrentVolume;
            await AudioPlayerService.SetVolumeAsync(0);
        }
        else
        {
            await AudioPlayerService.SetVolumeAsync(_volumeBeforeMute);
            _volumeBeforeMute = 0;
        }
    }

    private async Task OnPlayClick()
    {
        if (AudioPlayerService.IsPlaying)
            await AudioPlayerService.PauseAsync();
        else
            await AudioPlayerService.PlayAsync();
    }

    /// <summary>Открыть полноэкранный плеер: тап по бару (основной жест на мобиле) и по названию.</summary>
    private Task Expand() => OnExpandRequested.InvokeAsync();

    /// <summary>
    /// Пустышка для элементов, которые не должны открывать полный плеер: @onclick:stopPropagation
    /// работает только вместе с @onclick, поэтому нужен хоть какой-то обработчик.
    /// </summary>
    private static void Swallow() { }

    // Открытие полноэкранного плеера с клавиатуры (блок названия - role="button").
    private async Task OnTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await OnExpandRequested.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            AudioPlayerService.OnLoadAndPlayRequested -= OnServiceLoadAndPlay;
            AudioPlayerService.OnPlayRequested -= OnServicePlay;
            AudioPlayerService.OnPauseRequested -= OnServicePause;
            AudioPlayerService.OnSeekRequested -= OnServiceSeek;
            AudioPlayerService.OnVolumeChangeRequested -= OnServiceVolumeChange;
            AudioPlayerService.OnStateChanged -= OnServiceStateChanged;

            if (_audioElement != null)
            {
                // Circuit may already be gone during teardown - JS call is moot in that case.
                try { await _audioElement.InvokeVoidAsync("destroy"); } catch (JSDisconnectedException) { }
                await _audioElement.DisposeAsync();
            }
            if (_audioModule != null)
                await _audioModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disconnected during teardown - nothing left to clean up client-side.
        }
    }

    public void Dispose()
    {
        DisposeAsync().AsTask().Wait();
    }

    private void Noop() => Snackbar.Show("Скоро будет доступно", SnackbarSeverity.Info);
    private Task Swallow(MouseEventArgs _) => Task.CompletedTask;
}
