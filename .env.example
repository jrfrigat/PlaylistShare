# -----------------------------------------------------------------------------
# Production secrets for the API container. Copy this file to `.env` (which is
# git-ignored) and fill in real values. docker-compose auto-loads `.env` and
# injects these into the playlistshare.api service (see docker-compose.yml).
#
# These override the placeholder values in appsettings.Production.json, which is
# no longer baked into the image (see .dockerignore).
# -----------------------------------------------------------------------------

# Full SQL Server connection string. From inside the container the DB host is
# usually host.docker.internal (a SQL Server running on the Docker host).
CONNECTION_STRING=Server=host.docker.internal;Database=PlaylistShare;User Id=playlist_user;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT signing key - MUST be at least 32 characters. Generate a strong random one.
JWT_KEY=change-me-to-a-strong-random-key-min-32-chars

# -- Database provider --------------------------------------------------------
# SqlServer (default) or Postgres. CONNECTION_STRING above must match the provider:
#   SqlServer -> Server=host;Database=...;User Id=...;Password=...;TrustServerCertificate=True
#   Postgres  -> Host=host;Port=5432;Database=...;Username=...;Password=...
DB_PROVIDER=SqlServer

# Used ONLY by docker-compose.postgres.yml (containerized Postgres via
# run-docker-compose-postgres.bat). For an external Postgres, ignore these and put the full
# Npgsql string in CONNECTION_STRING above.
POSTGRES_DB=PlaylistShare
POSTGRES_USER=playlist_user
POSTGRES_PASSWORD=change-me
